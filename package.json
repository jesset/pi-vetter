{
  "name": "pi-vetter",
  "version": "0.1.1",
  "description": "Security vetting for Pi extension packages — evidence-driven evaluation before install/update",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "security",
    "supply-chain",
    "vulnerability",
    "scanner"
  ],
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "README.zh-cn.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/verify": "^4.1.2",
    "tar-stream": "^3.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@earendil-works/pi-tui": "^0.84.3",
    "@sigstore/tuf": "^5.0.0",
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
